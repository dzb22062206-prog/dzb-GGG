<style>
:root{
  --ink:#1e2235; --muted:#5d6478; --line:#e7e9f2;
  --bg:#ffffff; --soft:#f5f6fb; --card:#ffffff;
  --acc:#4f46e5; --acc2:#7c3aed; --ok:#059669;
  --grad:linear-gradient(135deg,#4f46e5,#7c3aed);
  --shadow:0 10px 40px rgba(30,34,53,.08);
  --r:18px;
}
*{margin:0;padding:0;box-sizing:border-box}
html{scroll-behavior:smooth}
body{font-family:'Segoe UI',system-ui,-apple-system,Arial,sans-serif;color:var(--ink);background:var(--bg);line-height:1.6}
img{max-width:100%;display:block}
a{color:var(--acc);text-decoration:none}
.wrap{max-width:1140px;margin:0 auto;padding:0 20px}

/* Header */
header{position:sticky;top:0;z-index:50;background:rgba(255,255,255,.85);backdrop-filter:blur(12px);border-bottom:1px solid var(--line)}
.nav{display:flex;align-items:center;justify-content:space-between;height:64px}
.logo{font-weight:800;font-size:1.15rem;color:var(--ink)}
.logo span{background:var(--grad);-webkit-background-clip:text;background-clip:text;color:transparent}
.nav-links{display:flex;gap:26px;list-style:none}
.nav-links a{color:var(--muted);font-size:.95rem;font-weight:500}
.nav-links a:hover{color:var(--acc)}
.btn{display:inline-flex;align-items:center;gap:8px;padding:12px 22px;border-radius:999px;font-weight:600;font-size:.95rem;cursor:pointer;border:none;transition:.2s}
.btn-grad{background:var(--grad);color:#fff;box-shadow:0 6px 20px rgba(79,70,229,.3)}
.btn-grad:hover{transform:translateY(-2px);box-shadow:0 10px 26px rgba(79,70,229,.4)}
.btn-ghost{background:#fff;color:var(--ink);border:1.5px solid var(--line)}
.btn-ghost:hover{border-color:var(--acc);color:var(--acc)}
.burger{display:none;font-size:1.5rem;background:none;border:none;color:var(--ink);cursor:pointer}

/* Hero */
.hero{padding:70px 0 60px;background:
  radial-gradient(700px 350px at 85% -10%,rgba(124,58,237,.10),transparent),
  radial-gradient(600px 300px at 0% 10%,rgba(79,70,229,.08),transparent)}
.badge{display:inline-block;background:#eef0ff;color:var(--acc);font-weight:600;font-size:.85rem;padding:7px 16px;border-radius:999px;margin-bottom:18px}
.hero h1{font-size:clamp(1.9rem,4.5vw,3.1rem);font-weight:800;line-height:1.15;letter-spacing:-.5px}
.hero h1 em{font-style:normal;background:var(--grad);-webkit-background-clip:text;background-clip:text;color:transparent}
.hero p.lead{color:var(--muted);font-size:1.1rem;max-width:600px;margin:18px 0 28px}
.hero-grid{display:grid;grid-template-columns:1.1fr .9fr;gap:40px;align-items:center}
.cta-row{display:flex;gap:14px;flex-wrap:wrap}
.stats{display:grid;grid-template-columns:repeat(4,1fr);gap:14px;margin-top:40px}
.stat{background:var(--card);border:1px solid var(--line);border-radius:var(--r);padding:16px;text-align:center;box-shadow:var(--shadow)}
.stat b{display:block;font-size:1.35rem;background:var(--grad);-webkit-background-clip:text;background-clip:text;color:transparent}
.stat span{font-size:.82rem;color:var(--muted)}
.hero-img{border-radius:22px;box-shadow:0 24px 60px rgba(79,70,229,.18);border:1px solid var(--line)}

/* Sections */
section{padding:70px 0}
.sec-head{text-align:center;max-width:640px;margin:0 auto 44px}
.sec-head h2{font-size:clamp(1.5rem,3vw,2.1rem);font-weight:800;letter-spacing:-.4px}
.sec-head p{color:var(--muted);margin-top:10px}
.grid-3{display:grid;grid-template-columns:repeat(3,1fr);gap:22px}
.grid-2{display:grid;grid-template-columns:repeat(3,1fr);gap:22px}
.card{background:var(--card);border:1px solid var(--line);border-radius:var(--r);padding:26px;box-shadow:var(--shadow);transition:.25s}
.card:hover{transform:translateY(-4px);box-shadow:0 16px 44px rgba(30,34,53,.12)}
.card .ico{width:48px;height:48px;border-radius:13px;background:#eef0ff;display:grid;place-items:center;font-size:1.3rem;margin-bottom:16px}
.card h3{font-size:1.08rem;margin-bottom:8px}
.card p{color:var(--muted);font-size:.93rem}

/* Prices */
.price-card{position:relative;text-align:center}
.price-card.hit{border:2px solid var(--acc);transform:scale(1.03)}
.tag{position:absolute;top:-13px;left:50%;transform:translateX(-50%);background:var(--grad);color:#fff;font-size:.75rem;font-weight:700;padding:5px 16px;border-radius:999px;white-space:nowrap}
.price-card .term{font-size:.8rem;color:var(--ok);font-weight:600}
.price-card .price{font-size:2rem;font-weight:800;margin:6px 0 16px}
.price-card ul{list-style:none;text-align:left;margin:0 0 22px;font-size:.9rem;color:var(--muted)}
.price-card li{padding:7px 0 7px 26px;position:relative;border-top:1px dashed var(--line)}
.price-card li::before{content:'✓';position:absolute;left:4px;color:var(--ok);font-weight:700}

/* Steps */
.steps{display:grid;grid-template-columns:repeat(4,1fr);gap:20px;counter-reset:step}
.step{background:var(--card);border:1px solid var(--line);border-radius:var(--r);padding:24px;position:relative;box-shadow:var(--shadow)}
.step .num{width:38px;height:38px;border-radius:50%;background:var(--grad);color:#fff;font-weight:700;display:grid;place-items:center;margin-bottom:14px}
.step h3{font-size:1rem;margin-bottom:6px}
.step p{font-size:.88rem;color:var(--muted)}
.step .time{display:inline-block;margin-top:10px;font-size:.75rem;color:var(--acc);background:#eef0ff;padding:3px 10px;border-radius:999px}

/* Guarantees */
.guar{background:var(--soft)}
.guar-card{display:flex;gap:14px;align-items:flex-start}
.guar-card .ico{flex:none}

/* Showcase */
.showcase img{border-radius:22px;box-shadow:0 24px 60px rgba(30,34,53,.15);border:1px solid var(--line)}
.showcase{display:grid;grid-template-columns:1fr 1fr;gap:44px;align-items:center}
.showcase h2{font-size:clamp(1.4rem,2.6vw,1.9rem);margin-bottom:14px}
.showcase p{color:var(--muted);margin-bottom:12px}

/* FAQ */
.faq{max-width:760px;margin:0 auto}
details{background:var(--card);border:1px solid var(--line);border-radius:14px;margin-bottom:12px;box-shadow:var(--shadow);overflow:hidden}
summary{padding:18px 22px;font-weight:600;cursor:pointer;list-style:none;display:flex;justify-content:space-between;align-items:center}
summary::after{content:'+';font-size:1.4rem;color:var(--acc);font-weight:700;transition:.2s}
details[open] summary::after{transform:rotate(45deg)}
details p{padding:0 22px 20px;color:var(--muted);font-size:.95rem}

/* Final CTA */
.final{background:var(--grad);border-radius:26px;color:#fff;text-align:center;padding:60px 30px;position:relative;overflow:hidden}
.final::before{content:'';position:absolute;inset:0;background:radial-gradient(500px 200px at 20% 20%,rgba(255,255,255,.15),transparent)}
.final h2{font-size:clamp(1.5rem,3vw,2.2rem);margin-bottom:14px;position:relative}
.final p{opacity:.92;margin-bottom:28px;position:relative}
.final .btn{position:relative}
.btn-white{background:#fff;color:var(--acc)}
.btn-white:hover{transform:translateY(-2px)}
.btn-outline{background:transparent;color:#fff;border:1.5px solid rgba(255,255,255,.5)}
.btn-outline:hover{background:rgba(255,255,255,.12)}

/* Footer */
footer{border-top:1px solid var(--line);padding:44px 0 100px;text-align:center;color:var(--muted);font-size:.9rem}
.foot-links{display:flex;gap:20px;justify-content:center;flex-wrap:wrap;margin:14px 0}
.foot-links a{font-weight:600}

/* Floating WhatsApp */
.fab{position:fixed;right:18px;bottom:18px;z-index:60;background:#25D366;color:#fff;font-weight:700;padding:14px 22px;border-radius:999px;box-shadow:0 10px 30px rgba(37,211,102,.45);display:inline-flex;align-items:center;gap:8px}
.fab:hover{transform:translateY(-2px)}

@media(max-width:920px){
  .hero-grid,.showcase{grid-template-columns:1fr}
  .grid-3,.grid-2{grid-template-columns:1fr 1fr}
  .steps{grid-template-columns:1fr 1fr}
  .price-card.hit{transform:none}
}
@media(max-width:620px){
  .grid-3,.grid-2,.steps{grid-template-columns:1fr}
  .stats{grid-template-columns:1fr 1fr}
  .nav-links{position:fixed;top:64px;left:0;right:0;background:#fff;flex-direction:column;padding:20px;gap:16px;border-bottom:1px solid var(--line);display:none}
  .nav-links.open{display:flex}
  .burger{display:block}
  .nav .btn{display:none}
  section{padding:50px 0}
}
</style>
